{
  "name": "aifyn-dashboard",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "dev:api": "wrangler dev --persist-to ../AiFyn/.wrangler/state --inspector-port 9230",
